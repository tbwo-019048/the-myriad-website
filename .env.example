NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase keep-alive cron. Set this on Vercel (any long random string). Vercel
# Cron sends it as a Bearer token to /api/keepalive, which runs one tiny query
# each day so the Supabase project never gets paused for inactivity.
CRON_SECRET=
